<?xml version="1.0" ?>
<!-- Gazebo Harmonic world description for the simulated lab environment. -->
<sdf version="1.10">
  <world name="lab">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient>
            <diffuse>0.8 0.8 0.77 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Lab room: 10 m x 8 m interior, walls 2.5 m tall. -->
    <model name="lab_walls">
      <static>true</static>

      <link name="wall_north">
        <pose>0 4 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_south">
        <pose>0 -4 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10.15 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.15 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_east">
        <pose>5 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 8 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="wall_west">
        <pose>-5 0 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 8 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Partial divider that gives the mapper some interior structure to close loops on. -->
      <link name="divider">
        <pose>0 2.2 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.15 2.4 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 2.4 2.5</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.82 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Furniture marking each named station in config/stations.yaml. -->
    <model name="workbench">
      <static>true</static>
      <pose>3.4 2.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 0.8 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 0.8 0.8</size></box></geometry>
          <material>
            <ambient>0.35 0.25 0.18 1</ambient>
            <diffuse>0.45 0.32 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="microscope_bench">
      <static>true</static>
      <pose>-3.2 2.4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 0.7 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 0.7 0.8</size></box></geometry>
          <material>
            <ambient>0.2 0.25 0.3 1</ambient>
            <diffuse>0.3 0.35 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="printer_3d">
      <static>true</static>
      <pose>-3.3 -2.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.9 0.9 1.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.9 0.9 1.0</size></box></geometry>
          <material>
            <ambient>0.15 0.15 0.17 1</ambient>
            <diffuse>0.22 0.22 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="meeting_table">
      <static>true</static>
      <pose>3.2 -2.4 0.37 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.8</radius><length>0.75</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.8</radius><length>0.75</length></cylinder></geometry>
          <material>
            <ambient>0.4 0.3 0.2 1</ambient>
            <diffuse>0.55 0.42 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="storage_shelf">
      <static>true</static>
      <pose>0 -3.5 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.5 1.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.5 1.8</size></box></geometry>
          <material>
            <ambient>0.3 0.3 0.32 1</ambient>
            <diffuse>0.4 0.4 0.43 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
